# ──────────────────────────────────────────────
# Finovert Backend - Environment Configuration
# Copy this file to .env and fill in the values
# ──────────────────────────────────────────────

# Node environment: 'development' | 'production'
NODE_ENV=production

# Server port
PORT=5000

# Frontend URL (for CORS whitelist)
CLIENT_ORIGIN=https://yourdomain.com

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/finovert?retryWrites=true&w=majority

# Gmail SMTP credentials
# 1. Use your Gmail address
# 2. Create an App Password at: https://myaccount.google.com/apppasswords
#    (Requires 2FA to be enabled on your Google account)
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
